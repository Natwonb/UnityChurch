{
  "name": "Giving",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string"
    },
    "member_key": {
      "type": "string"
    },
    "member_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "fund": {
      "type": "string",
      "enum": [
        "tithe",
        "offering",
        "building",
        "missions",
        "other"
      ],
      "default": "tithe"
    },
    "method": {
      "type": "string",
      "enum": [
        "card",
        "cash",
        "check",
        "transfer"
      ],
      "default": "cash"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "note": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "recorded",
        "pending",
        "paid",
        "failed"
      ],
      "default": "recorded"
    }
  },
  "required": [
    "church_id",
    "amount",
    "fund"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}