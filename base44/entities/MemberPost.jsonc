{
  "name": "MemberPost",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "birthday",
        "anniversary",
        "new_baby",
        "wedding",
        "graduation",
        "condolence",
        "prayer",
        "praise",
        "other"
      ],
      "default": "other"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "author_key": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    }
  },
  "required": [
    "church_id",
    "title"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}