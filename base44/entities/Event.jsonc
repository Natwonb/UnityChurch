{
  "name": "Event",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "rehearsal",
        "service",
        "meeting",
        "outreach",
        "other"
      ],
      "default": "rehearsal"
    },
    "author_key": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    }
  },
  "required": [
    "church_id",
    "title",
    "date"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}