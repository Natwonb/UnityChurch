{
  "name": "Comment",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string"
    },
    "post_id": {
      "type": "string"
    },
    "post_type": {
      "type": "string",
      "enum": [
        "department",
        "news"
      ],
      "default": "department"
    },
    "author_key": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "body": {
      "type": "string"
    }
  },
  "required": [
    "church_id",
    "post_id",
    "body"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}