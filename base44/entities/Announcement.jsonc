{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "event_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "flyer",
        "manual"
      ],
      "default": "manual"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft"
      ],
      "default": "published"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "author_key": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    }
  },
  "required": [
    "church_id",
    "title"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}