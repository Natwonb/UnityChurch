{
  "name": "Reaction",
  "type": "object",
  "properties": {
    "church_id": {
      "type": "string"
    },
    "post_id": {
      "type": "string"
    },
    "post_type": {
      "type": "string",
      "enum": [
        "department",
        "news"
      ],
      "default": "department"
    },
    "member_key": {
      "type": "string"
    },
    "member_name": {
      "type": "string"
    },
    "reaction": {
      "type": "string",
      "enum": [
        "amen",
        "love",
        "praying",
        "praise"
      ],
      "default": "amen"
    }
  },
  "required": [
    "church_id",
    "post_id",
    "member_key"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}