{
  "name": "Church",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "pastor_name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "cover_image_url": {
      "type": "string"
    },
    "welcome_message": {
      "type": "string"
    },
    "join_code": {
      "type": "string",
      "description": "Invite code shown only to church admins in the UI; verified on join via backend when possible"
    },
    "admin_member_key": {
      "type": "string",
      "description": "Legacy admin pointer \u2014 never expose to regular members",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}